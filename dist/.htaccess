# Custom 404 error page
ErrorDocument 404 /404.html

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # 1. If direct file exists, serve it
  RewriteCond %{REQUEST_FILENAME} -f
  RewriteRule ^ - [L]

  # 2. If direct directory exists, serve it
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # 3. Clean product URLs without trailing slash (e.g. /product/sorrel-drink -> /product/sorrel-drink/index.html)
  RewriteCond %{DOCUMENT_ROOT}/product/$1/index.html -f
  RewriteRule ^product/([^/]+)/?$ /product/$1/index.html [L]

  # 4. Clean 404 route
  RewriteRule ^404/?$ /404.html [L]

  # 5. Fallback non-existent requests to custom 404 page
  RewriteRule . /404.html [L]
</IfModule>
